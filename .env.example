# AVIS Environment Variables Template
# Copy this file to .env and fill in your values

# ── HuggingFace ──────────────────────────────────────────────
HF_TOKEN=your_huggingface_token_here

# ── LangSmith (optional, for agent observability) ────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=avis-emotion-captioning

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ── Model Paths ──────────────────────────────────────────────
EMOTION_MODEL_PATH=./weights/emotion_model_best.pth
YOLO_MODEL_PATH=./weights/yolov8n-face.pt

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Inference ────────────────────────────────────────────────
DEVICE=cuda           # cuda or cpu
BLIP_PRECISION=float16   # float16 for 4GB GPU
MAX_CAPTION_LENGTH=50
EMOTION_CONFIDENCE_THRESHOLD=0.45
